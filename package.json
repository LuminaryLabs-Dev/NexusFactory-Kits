{
  "name": "@luminarylabs/nexusfactory-kits",
  "version": "0.1.0",
  "type": "module",
  "description": "Registry-driven procedural factory domains and generation kits for NexusFactory.",
  "exports": {
    ".": "./src/index.js",
    "./registry": "./registry.json"
  },
  "scripts": {
    "registry:build": "node scripts/build-registry.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "npm run registry:build && npm test",
    "demo": "node scripts/demo.mjs",
    "coral:render": "node scripts/render-coral-validation.mjs",
    "coral:3d:generate": "node tools/coral-3d/generate.mjs",
    "coral:3d:validate": "node tools/coral-3d/validate.mjs",
    "fish:generate": "node tools/fish/generate.mjs",
    "fish:validate": "node tools/fish/validate.mjs",
    "fish:inspect": "node tools/fish/inspect-glb.mjs",
    "fish:batch": "node tools/fish/batch-generate.mjs",
    "fish:review": "node tools/fish/run-review-pipeline.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "three": "0.180.0"
  },
  "license": "MIT"
}
